{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cloud-repo-memory:local-mvp:v1",
  "title": "Local read-only memory MVP v1",
  "description": "Select a named $defs schema for configuration, parsed frontmatter, tool input or tool output. Filesystem and cross-field rules are normative in docs/local-mvp-contract.md.",
  "anyOf": [
    { "$ref": "#/$defs/configuration" },
    { "$ref": "#/$defs/frontmatter" },
    { "$ref": "#/$defs/listMemoryIndexInput" },
    { "$ref": "#/$defs/getMemoryInput" },
    { "$ref": "#/$defs/listMemoryIndexOutput" },
    { "$ref": "#/$defs/getMemoryOutput" }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?![\\s\\S])"
    },
    "version": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
    },
    "shortText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 280,
      "pattern": "^[^\\u0000-\\u001f\\u007f\\u2028\\u2029]+(?![\\s\\S])"
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "projects"],
      "properties": {
        "schema_version": { "const": 1 },
        "projects": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["project", "root"],
            "properties": {
              "project": { "$ref": "#/$defs/identifier" },
              "root": { "type": "string", "minLength": 1, "maxLength": 4096 }
            }
          }
        }
      }
    },
    "frontmatter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "id", "project", "title", "summary", "read_when", "status", "approval"],
      "properties": {
        "schema_version": { "const": 1 },
        "id": { "$ref": "#/$defs/identifier" },
        "project": { "$ref": "#/$defs/identifier" },
        "title": {
          "allOf": [
            { "$ref": "#/$defs/shortText" },
            { "maxLength": 120 }
          ]
        },
        "summary": { "$ref": "#/$defs/shortText" },
        "read_when": { "$ref": "#/$defs/shortText" },
        "status": { "enum": ["draft", "active", "archived", "superseded"] },
        "approval": { "enum": ["pending", "approved", "rejected"] }
      }
    },
    "eligibleFrontmatter": {
      "allOf": [
        { "$ref": "#/$defs/frontmatter" },
        {
          "properties": {
            "status": { "const": "active" },
            "approval": { "const": "approved" }
          }
        }
      ]
    },
    "listMemoryIndexInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project"],
      "properties": { "project": { "$ref": "#/$defs/identifier" } }
    },
    "getMemoryInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project", "memory_id"],
      "properties": {
        "project": { "$ref": "#/$defs/identifier" },
        "memory_id": { "$ref": "#/$defs/identifier" },
        "expected_version": { "$ref": "#/$defs/version" }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["started_at", "finished_at", "elapsed_ms", "consistency", "cloud_freshness"],
      "properties": {
        "started_at": { "type": "string", "format": "date-time" },
        "finished_at": { "type": "string", "format": "date-time" },
        "elapsed_ms": { "type": "number", "minimum": 0 },
        "consistency": { "const": "local-best-effort" },
        "cloud_freshness": { "const": "unknown" }
      }
    },
    "errorCode": {
      "enum": [
        "INVALID_ARGUMENT",
        "UNKNOWN_PROJECT",
        "PROJECT_UNAVAILABLE",
        "INVALID_METADATA",
        "DUPLICATE_ID",
        "FILE_UNAVAILABLE",
        "SCOPE_VIOLATION",
        "LIMIT_EXCEEDED",
        "LOCAL_CHANGE_DETECTED",
        "MEMORY_NOT_FOUND",
        "MEMORY_INELIGIBLE",
        "MEMORY_CHANGED",
        "INTERNAL_ERROR"
      ]
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "$ref": "#/$defs/errorCode" },
        "message": { "$ref": "#/$defs/shortText" },
        "memory_id": { "$ref": "#/$defs/identifier" },
        "field": {
          "enum": ["schema_version", "id", "project", "title", "summary", "read_when", "status", "approval"]
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "diagnostics", "diagnostics_omitted", "scan_complete"],
      "properties": {
        "code": { "$ref": "#/$defs/errorCode" },
        "message": { "$ref": "#/$defs/shortText" },
        "diagnostics": {
          "type": "array",
          "maxItems": 20,
          "items": { "$ref": "#/$defs/diagnostic" }
        },
        "diagnostics_omitted": { "type": "integer", "minimum": 0 },
        "scan_complete": { "type": "boolean" }
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_version", "ok", "observation", "error"],
      "properties": {
        "contract_version": { "const": "local-mvp-v1" },
        "ok": { "const": false },
        "observation": { "$ref": "#/$defs/observation" },
        "error": { "$ref": "#/$defs/error" }
      }
    },
    "listMemoryIndexSuccess": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_version", "ok", "project", "observation", "index_version", "index_markdown", "entry_count", "excluded_count", "index_utf8_bytes"],
      "properties": {
        "contract_version": { "const": "local-mvp-v1" },
        "ok": { "const": true },
        "project": { "$ref": "#/$defs/identifier" },
        "observation": { "$ref": "#/$defs/observation" },
        "index_version": { "$ref": "#/$defs/version" },
        "index_markdown": { "type": "string", "minLength": 1, "maxLength": 131072 },
        "entry_count": { "type": "integer", "minimum": 0, "maximum": 200 },
        "excluded_count": { "type": "integer", "minimum": 0, "maximum": 200 },
        "index_utf8_bytes": { "type": "integer", "minimum": 1, "maximum": 131072 }
      }
    },
    "getMemorySuccess": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_version", "ok", "project", "memory_id", "observation", "source_version", "metadata", "body_markdown", "source_utf8_bytes"],
      "properties": {
        "contract_version": { "const": "local-mvp-v1" },
        "ok": { "const": true },
        "project": { "$ref": "#/$defs/identifier" },
        "memory_id": { "$ref": "#/$defs/identifier" },
        "observation": { "$ref": "#/$defs/observation" },
        "source_version": { "$ref": "#/$defs/version" },
        "metadata": { "$ref": "#/$defs/eligibleFrontmatter" },
        "body_markdown": { "type": "string", "maxLength": 262144 },
        "source_utf8_bytes": { "type": "integer", "minimum": 1, "maximum": 262144 }
      }
    },
    "listMemoryIndexOutput": {
      "oneOf": [
        { "$ref": "#/$defs/listMemoryIndexSuccess" },
        { "$ref": "#/$defs/failure" }
      ]
    },
    "getMemoryOutput": {
      "oneOf": [
        { "$ref": "#/$defs/getMemorySuccess" },
        { "$ref": "#/$defs/failure" }
      ]
    }
  }
}
